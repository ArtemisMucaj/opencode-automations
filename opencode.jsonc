{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./",
      "options": {
        "tickSeconds": 30,
        "defaultTimeoutMinutes": 30,
        // Desktop notifications for what automations report.
        "outbox": {
          "destinations": [{ "id": "desktop", "type": "Notification.Native" }],
        },
        // No sample jobs run automatically.
        // See examples/opencode.jsonc for opt-in configuration.
        "jobs": [],
      },
    },
  ],
}
