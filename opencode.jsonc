{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./",
      "options": {
        "tickSeconds": 30,
        "defaultTimeoutMinutes": 30,
        // macOS notifications enabled for automation run completion.
        "notify": {
          "macos": true,
        },
        // No sample jobs run automatically.
        // See examples/opencode.jsonc for opt-in configuration.
        "jobs": [],
      },
    },
  ],
}
